# Copy to .env and fill in from your Supabase project settings (Project Settings > API).
# The publishable/anon key is safe to ship in a client bundle: Row Level Security
# is what protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
